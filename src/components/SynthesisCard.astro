---
import type { Synthesis } from '@/lib/syntheses';
import { withBase } from '@/lib/paths';

interface Props {
  synthesis: Synthesis;
  index?: number;
}

const { synthesis, index = 0 } = Astro.props;
const href = withBase(`/insights/${synthesis.id}/`, import.meta.env.BASE_URL);
---

<article
  class="synthesis-card"
  style={`--card-index: ${index}`}
  data-synthesis-card
>
  <div class="synthesis-card__index" aria-hidden="true">
    <span>洞察</span>
    <strong>{String(index + 1).padStart(2, '0')}</strong>
  </div>
  <div class="synthesis-card__body">
    <p class="eyebrow">MONTHLY SYNTHESIS · {synthesis.relatedMeetings.length} 场关联会议</p>
    <h2><a href={href}>{synthesis.title}</a></h2>
    <p>{synthesis.abstract}</p>
    <ul class="tag-list" aria-label="标签">
      {synthesis.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <a class="synthesis-card__arrow" href={href} aria-label={`阅读月度洞察：${synthesis.title}`}>
    <span aria-hidden="true">↗</span>
  </a>
</article>
